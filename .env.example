# Copia este archivo como .env y completa los valores
ANTHROPIC_API_KEY=sk-ant-...
# Modelo: claude-opus-5-5 (mejor calidad) o claude-sonnet-5-5 (mas barato)
CLAUDE_MODEL=claude-opus-5-5

# Envio por email (Gmail: activa verificacion en 2 pasos y crea una "contrasena de aplicacion")
SMTP_EMAIL=tu.correo@gmail.com
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
LIMITE_DIARIO=15
